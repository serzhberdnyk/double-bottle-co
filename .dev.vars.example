ADMIN_EMAILS=owner@example.com
# Content-only editors can publish and restore catalog versions; leave empty until authorized.
CATALOG_EDITOR_EMAILS=
# Set a separate long random server-only token for administrative CLI access.
ADMIN_TOKEN=
# No Google credentials are required for the manual reviewed import workflow.
# Never add service credentials to NEXT_PUBLIC_ variables.

SITE_ORIGIN=https://your-site.example
# Enable only after the public-launch review; does not control access permissions.
PUBLIC_INDEXING=false
